# Instantly API v2 key — Instantly > Settings > Integrations > API Keys
INSTANTLY_API_KEY=

# Upstash Redis — added automatically if you install the Upstash integration
# from the Vercel Marketplace (Storage tab). For local dev, copy the values
# from the Vercel dashboard or your Upstash console.
# Vercel may inject KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Simple basic-auth gate so your board isn't public. Pick anything.
APP_USER=micheal
APP_PASS=change-me
